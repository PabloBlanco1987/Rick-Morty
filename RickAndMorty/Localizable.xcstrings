          }
        }
      }
    },
    "appError.offline.message" : {
      "extractionState" : "manual",
      "comment" : "AppError.offline: what the user can do about having no connection.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your Wi-Fi or mobile data and try again."
          }
        }
      }
    },
    "appError.offline.title" : {
      "extractionState" : "manual",
