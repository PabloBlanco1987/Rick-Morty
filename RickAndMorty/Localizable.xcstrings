  "strings" : {
    "appError.decoding.message" : {
      "extractionState" : "manual",
      "comment" : "AppError.decoding: what the user can do about a response that failed to decode.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't read the answer. Try again, and if it keeps happening it's on us."
          }
        }
      }
    },
    "appError.decoding.title" : {
      "extractionState" : "manual",
      "comment" : "AppError.decoding: what went wrong when the response failed to decode.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something came back wrong"
          }
        }
      }
    },
    "appError.notFound.message" : {
      "extractionState" : "manual",
      "comment" : "AppError.notFound: what the user can do when the thing they wanted isn't there.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't find what you were looking for."
          }
        }
      }
    },
    "appError.notFound.title" : {
      "extractionState" : "manual",
