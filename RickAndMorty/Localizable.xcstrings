          }
        }
      }
    },
    "characterList.clearFiltersButton": {
      "extractionState": "manual",
      "comment": "A button that clears all the filters, shown from the empty state when a search with active filters yields no results.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear filters"
          }
        }
      }
    },
    "characterList.clearSearchAndFiltersButton": {
      "extractionState": "manual",
      "comment": "A button that clears both the search text and the filters, shown from the empty state when a search combined with filters yields no results.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear search and filters"
          }
        }
      }
    },
    "characterList.clearSearchButton": {
      "extractionState": "manual",
      "comment": "A button that clears the search text, shown from the empty state when a search with no filters yields no results.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear search"
          }
        }
      }
    },
    "characterList.empty.description": {
      "extractionState": "manual",
      "comment": "A description of the state of an empty screen, with no filters active.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's nothing to show here yet."
          }
        }
      }
    },
    "characterList.empty.title": {
      "extractionState": "manual",
      "comment": "Title of the empty state when the full list, with nothing narrowing it, has no characters.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No characters"
          }
        }
      }
    },
    "characterList.filtersButton.title": {
      "extractionState": "manual",
      "comment": "The label for the toolbar button that opens the character filters.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filters"
          }
        }
      }
    },
    "characterList.noMatches.description": {
      "extractionState": "manual",
      "comment": "Description of the empty state shown when the list is narrowed by a search, by filters, or by both, and nothing matches. Keep the wording neutral so it fits all three cases.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No characters match what you're looking for."
          }
        }
      }
    },
    "characterList.noMatches.title": {
      "extractionState": "manual",
      "comment": "Title of the empty state shown when the list is narrowed by a search, by filters, or by both, and nothing matches. Keep the wording neutral so it fits all three cases.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matches"
          }
        }
      }
    },
    "characterList.refreshFailed.message": {
      "extractionState": "manual",
      "comment": "Body of the notice shown at the top of the list when a pull to refresh fails and the previous list is kept. Preceded by the error title (appError.*.title).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't refresh, so what you see may be out of date."
          }
        }
      }
    },
    "characterList.retryButton": {
      "extractionState": "manual",
      "comment": "A button that says \"Try again\" and triggers a retry, shown when a page failed to load or the whole list failed to load.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "characterList.searchPrompt": {
      "extractionState": "manual",
      "comment": "A placeholder for the search bar in the navigation bar.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search characters"
          }
        }
      }
    },
    "characterList.title": {
      "extractionState": "manual",
      "comment": "A title for the list of characters.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Characters"
          }
        }
      }
    },
    "characterStatus.alive": {
