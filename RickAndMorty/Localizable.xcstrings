        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easy there"
          }
        }
      }
    },
    "appError.server.message" : {
      "extractionState" : "manual",
      "comment" : "AppError.server: what the user can do about a server-side failure.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's not you. Give it a moment and try again."
          }
        }
      }
    },
    "appError.server.title" : {
