        }
      }
    },
    "appError.rateLimited.message" : {
      "extractionState" : "manual",
      "comment" : "AppError.rateLimited: what the user can do about the server throttling requests.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We're asking for characters faster than the server will hand them over. Give it a second."
          }
        }
      }
    },
    "appError.rateLimited.title" : {
      "extractionState" : "manual",
      "comment" : "AppError.rateLimited: what went wrong when the server throttles requests.",
