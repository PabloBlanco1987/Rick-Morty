{
  "sourceLanguage": "en",
  "strings": {
    "appError.decoding.message": {
      "extractionState": "manual",
      "comment": "AppError.decoding: what the user can do about a response that failed to decode.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't read the answer. Try again, and if it keeps happening it's on us."
          }
        }
      }
    },
    "appError.decoding.title": {
      "extractionState": "manual",
      "comment": "AppError.decoding: what went wrong when the response failed to decode.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something came back wrong"
          }
        }
      }
    },
    "appError.notFound.message": {
      "extractionState": "manual",
      "comment": "AppError.notFound: what the user can do when the thing they wanted isn't there.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't find what you were looking for."
          }
        }
      }
    },
    "appError.notFound.title": {
      "extractionState": "manual",
      "comment": "AppError.notFound: what went wrong when the requested thing doesn't exist.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here"
          }
        }
      }
    },
    "appError.offline.message": {
      "extractionState": "manual",
      "comment": "AppError.offline: what the user can do about having no connection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your Wi-Fi or mobile data and try again."
          }
        }
      }
    },
    "appError.offline.title": {
      "extractionState": "manual",
      "comment": "AppError.offline: what went wrong when the device has no connection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection"
          }
        }
      }
    },
    "appError.rateLimited.message": {
      "extractionState": "manual",
      "comment": "AppError.rateLimited: what the user can do about the server throttling requests.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're asking for characters faster than the server will hand them over. Give it a second."
          }
        }
      }
    },
    "appError.rateLimited.title": {
      "extractionState": "manual",
      "comment": "AppError.rateLimited: what went wrong when the server throttles requests.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy there"
          }
        }
      }
    },
    "appError.server.message": {
      "extractionState": "manual",
      "comment": "AppError.server: what the user can do about a server-side failure.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not you. Give it a moment and try again."
          }
        }
      }
    },
    "appError.server.title": {
      "extractionState": "manual",
      "comment": "AppError.server: what went wrong when the server itself is failing.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is having a bad day"
          }
        }
      }
    },
    "appError.timeout.message": {
      "extractionState": "manual",
      "comment": "AppError.timeout: what the user can do about a slow connection.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection is slow right now. Try again in a moment."
          }
        }
      }
    },
    "appError.timeout.title": {
      "extractionState": "manual",
      "comment": "AppError.timeout: what went wrong when the request takes too long.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is taking too long"
          }
        }
      }
    },
    "appError.unknown.message": {
      "extractionState": "manual",
      "comment": "AppError.cancelled and AppError.unknown: the generic call to action when nothing more specific applies.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again."
          }
        }
      }
    },
    "appError.unknown.title": {
      "extractionState": "manual",
      "comment": "AppError.cancelled and AppError.unknown: the generic title when nothing more specific applies.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        }
      }
    },
    "characterCard.skeletonNameLabel": {
      "extractionState": "manual",
      "comment": "Placeholder text shown in place of a character's name while the list skeleton is redacted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Character name"
          }
        }
      }
    },
    "characterCard.skeletonSpeciesLabel": {
      "extractionState": "manual",
      "comment": "Placeholder text shown in place of a character's species while the list skeleton is redacted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Species"
          }
        }
      }
    },
    "characterDetail.episodeCode": {
      "extractionState": "manual",
      "comment": "Chip under an episode's name on the detail screen, saying where the episode sits in the series. %1$lld is the season number and %2$lld the episode number within it; both are plain numbers, with no padding zeros. The middle dot separates the two halves — replace it, reorder the placeholders, or drop it if the language reads better another way.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season %1$lld · Episode %2$lld"
          }
        }
      }
    },
    "characterDetail.episodesCountBadge": {
      "extractionState": "manual",
      "comment": "Capsule next to the \"Episodes\" heading on the detail screen. %lld is how many episodes the character appears in; shown as the bare number in English.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "characterDetail.episodesTitle": {
      "extractionState": "manual",
      "comment": "A heading for the episodes of a character.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Episodes"
          }
        }
      }
    },
    "characterDetail.genderLabel": {
      "extractionState": "manual",
      "comment": "A label for a character's gender in the detail screen's information section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gender"
          }
        }
      }
    },
    "characterDetail.informationTitle": {
      "extractionState": "manual",
      "comment": "A heading for the information about a character.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Information"
          }
        }
      }
    },
    "characterDetail.locationLabel": {
      "extractionState": "manual",
      "comment": "A label for a character's location in the detail screen's information section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location"
          }
        }
      }
    },
    "characterDetail.noEpisodes": {
      "extractionState": "manual",
      "comment": "A message that appears when a character doesn't appear in any episode.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This character doesn't appear in any episode."
          }
        }
      }
    },
    "characterDetail.originLabel": {
      "extractionState": "manual",
      "comment": "A label for a character's origin in the detail screen's information section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin"
          }
        }
      }
    },
    "characterDetail.retryButton": {
      "extractionState": "manual",
      "comment": "A button that says \"Try again\" and triggers a retry, shown when the episodes section or the whole detail screen failed to load.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "characterDetail.skeletonEpisodeName": {
      "extractionState": "manual",
      "comment": "Placeholder text shown in place of an episode's name while the episodes skeleton is redacted: it only sizes the gray bar.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Episode title"
          }
        }
      }
    },
    "characterDetail.speciesLabel": {
      "extractionState": "manual",
      "comment": "A label for a character's species in the detail screen's information section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Species"
          }
        }
      }
    },
    "characterDetail.typeLabel": {
      "extractionState": "manual",
      "comment": "A label for a character's type in the detail screen's information section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type"
          }
        }
      }
    },
    "characterDetail.unknownPlace": {
      "extractionState": "manual",
      "comment": "Shown as the origin or location of a character when the API does not know it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
      }
    },
    "characterFilters.clearButton": {
      "extractionState": "manual",
      "comment": "A button that clears all the filters.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        }
      }
    },
    "characterFilters.doneButton": {
      "extractionState": "manual",
      "comment": "A button that closes the filters sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "characterFilters.gender.any": {
      "extractionState": "manual",
      "comment": "Picker option meaning \"do not filter by gender\". Separate key from characterFilters.status.any so each can agree grammatically with its noun in languages that need it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any"
          }
        }
      }
    },
    "characterFilters.genderPicker.title": {
      "extractionState": "manual",
      "comment": "A label for a picker that lets the user select a character's gender.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gender"
          }
        }
      }
    },
    "characterFilters.speciesField.prompt": {
      "extractionState": "manual",
      "comment": "Placeholder for the species text field in the filters sheet: examples of what to type. Kept short so it is not truncated at accessibility text sizes. The API matches species by English text, so the examples must stay in English.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Human, Alien…"
          }
        }
      }
    },
    "characterFilters.speciesSection.footer": {
      "extractionState": "manual",
      "comment": "A description of how the species filter works.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server matches partial names, so \"hum\" already finds humans."
          }
        }
      }
    },
    "characterFilters.speciesSection.title": {
      "extractionState": "manual",
      "comment": "A heading for the species filter section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Species"
          }
        }
      }
    },
    "characterFilters.status.any": {
      "extractionState": "manual",
      "comment": "Picker option meaning \"do not filter by status\". Separate key from characterFilters.gender.any so each can agree grammatically with its noun in languages that need it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any"
          }
        }
      }
    },
    "characterFilters.statusPicker.title": {
      "extractionState": "manual",
      "comment": "A label for a picker that lets the user select a character's status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        }
      }
    },
    "characterFilters.title": {
      "extractionState": "manual",
      "comment": "A heading for the screen that lets the user filter the list of characters.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filters"
          }
        }
      }
    },
    "characterGender.female": {
      "extractionState": "manual",
      "comment": "Character.Gender.female, as shown to the user.",
